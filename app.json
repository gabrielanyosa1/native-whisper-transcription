{
  "expo": {
    "name": "MyWhisperApp",
    "slug": "MyWhisperApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "whisperAndroidcom.mycompany.whisperandroid",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app requires microphone access to transcribe speech",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "whisperAndroidcom.mycompany.whisperandroid"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "62c28894-e96c-40d1-842c-513eb66d8472"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "flipper": false
          }
        }
      ]
    ]
  }
}
